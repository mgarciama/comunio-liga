{
  "name": "comunio-liga",
  "compatibility_date": "2026-07-27",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "COMUNIO",
